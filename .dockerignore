# Platform-specific and rebuilt inside the image -- Astral's Docker guide
# calls out .venv specifically, since a host venv is not portable.
**/.venv/
**/node_modules/
**/__pycache__/
**/*.pyc

# Build output; the image builds its own.
frontend/.next/
frontend/out/
backend/src/pos/web/
backend/dist/

# Local state and secrets. env_file passes .env in at run time instead.
data/
.env
**/.env
*.db

.git/
docs/
*.png
*.jpg
