# Copy to .env and adjust as needed — used by docker-compose.yml.

POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos

# LM Studio (or any OpenAI-compatible server) running on the host, reachable
# from inside the backend container.
LOCAL_BASE_URL=http://host.docker.internal:1234/v1

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# openssl rand -base64 32
JWT_SECRET=replace-me-with-a-random-32-byte-secret
# openssl rand -base64 32   (must decode to exactly 32 bytes)
ENCRYPTION_KEY=replace-me-with-a-random-base64-32-byte-key

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
DB_POOL_MAX_SIZE=10
