# Copy to .env and adjust as needed — used by docker-compose.yml.

POSTGRES_USER=pos
POSTGRES_PASSWORD=pos   # a development default: fine while Postgres only listens on 127.0.0.1. Change it (and
                        # recreate the pgdata volume, which keeps the old password) for anything shared.
POSTGRES_DB=pos

# OPTIONAL. No LLM endpoint is assumed: leave unset and each user adds their own
# (Settings page). Set only to give every user a shared server, e.g. LM Studio on
# the host, reachable
# from inside the backend container.
# LOCAL_BASE_URL=http://host.docker.internal:1234/v1

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# openssl rand -base64 32
JWT_SECRET=replace-me-with-a-random-32-byte-secret
# openssl rand -base64 32   (must decode to exactly 32 bytes)
ENCRYPTION_KEY=replace-me-with-a-random-base64-32-byte-key

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
DB_POOL_MAX_SIZE=10

# Where a magic-link sign-in email points -- your deployed frontend URL.
FRONTEND_URL=http://localhost:3000

# SMTP, for magic-link sign-in emails. Gmail example: create an app
# password at https://myaccount.google.com/apppasswords (2FA required)
# rather than using your real account password.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=True
MAIL_SSL=False

# May a user point the server at an LLM on a private or loopback address (LM Studio /
# Ollama on this machine or your LAN)? True for a personal install. Leave false on a
# shared server: otherwise any user could make the backend call your internal services.
# Link-local and cloud-metadata addresses are refused either way.
ALLOW_PRIVATE_LLM_URLS=true

# Swagger UI at /docs and the OpenAPI schema. Off unless you are developing against the API.
ENABLE_API_DOCS=false

# Print what people and the assistant say to the server log. Off: conversations are private.
LOG_CONVERSATIONS=false

# Which address the published ports (3000 web, 8000 API) bind to. 127.0.0.1 = this machine
# only (the default). Set 0.0.0.0 to reach the app from other devices on your network -- and
# then also set COOKIE_SECURE / use https, and change POSTGRES_PASSWORD above.
# BIND_ADDRESS=127.0.0.1

# Key rotation: put the NEW key in ENCRYPTION_KEY and the old one(s) here (comma-separated).
# Saved credentials re-encrypt under the new key as they are read; then remove this line.
# ENCRYPTION_KEY_PREVIOUS=
