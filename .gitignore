# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local model assets (766MB, own nested .git+LFS repo — never commit this)
/backend/assets/

# Downloaded pretrained wake-word classifier models (auto-fetched on first use)
/.cache/

# Your own recorded wake-word phrase samples (local-wake) — personal voice data
/wake_word_samples/

# Ad-hoc screenshots/output from manual or Playwright-driven UI checks
/.playwright-mcp/
*.png
*.jpg
*.jpeg

# Scratch notes and fetched reference docs -- useful locally, not part of the app
/docs/

# Postgres data volume (docker-compose)
/pgdata/

# Backend's local SQLite checkpoint db (session/memory storage)
/data/

# Frontend
/frontend/node_modules/
/frontend/.next/

# Local env overrides
.env

# Downloaded model files (HF cache + nltk), mounted into the backend container
/models/
# Supertonic TTS assets (own nested git+LFS repo)
/assets/

# `next build` scratch output. The copy that ships is committed at
# backend/src/pos/static/ -- see frontend's build:app script.
/frontend/out/
