# Backend base URLs the browser client talks to. Required because in
# Docker Compose (or any deployment where the frontend and backend are
# separate containers/origins) the frontend can't assume same-origin the
# way the old server-rendered static/index.html could.
#
# Local dev (backend running on the host via `uv run server.py`):
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Docker Compose example, if the backend service is named "backend" and
# this is reached from the *browser* (not container-to-container), point
# it at wherever the backend is actually published, e.g.:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
